{
  "name": "pp-api",
  "version": "1.16.24",
  "description": "See readme.md",
  "main": "src/server.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "npm run build && node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "cli": "tsx src/cli/index.ts",
    "cli:help": "tsx src/cli/index.ts --help",
    "backup": "task db:backup",
    "interactive": "node test/interactive.js",
    "start:prod": "task server:start ENV=production",
    "start:acc": "task server:start ENV=acceptance",
    "api": "bash scripts/host-api.sh",
    "test:api": "task test:api",
    "generate:openapi": "node scripts/generate-openapi-spec.js",
    "test:unit": "npm run build && node --test \"dist/test/unit/**/*.spec.js\"",
    "test:contract": "node --test dist/test/unit/api/middleware/auth.spec.js dist/test/unit/api/middleware/authorization.spec.js dist/test/unit/api/controllers/auth.spec.js dist/test/unit/api/controllers/system.spec.js dist/test/unit/api/controllers/tournaments.spec.js dist/test/unit/api/controllers/tournaments-createFixturesWithTournament.spec.js dist/test/unit/api/routes/fixture-contract.spec.js dist/test/unit/api/services/mock-parity.spec.js dist/test/unit/validate-tsv.spec.js",
    "verify:contract": "npm run build && npm run test:contract",
    "migrate:received-tournaments": "node scripts/migrate-received-tournaments.js",
    "migrate:recent-schema": "node scripts/migration/apply-recent-schema.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/glob": "^8.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.8.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "glob": "^11.0.3",
    "inquirer": "^12.4.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^7.0.10",
    "pdfjs-dist": "^3.11.174",
    "sharp": "^0.34.4",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/inquirer": "^9.0.8",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.4",
    "@types/nodemailer": "^7.0.4",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "globals": "^16.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
